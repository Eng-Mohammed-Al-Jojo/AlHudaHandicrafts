rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'huda@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Visitors can submit a valid order directly from Checkout.
      allow create: if request.resource.data.customer is string
                    && request.resource.data.phone is string
                    && request.resource.data.total is number;
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      // Visitors may create one well-formed newsletter subscription only.
      // Reading and managing the mailing list always stays admin-only.
      allow create: if request.resource.data.keys().hasOnly([
                      'email', 'source', 'status', 'createdAt'
                    ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
                    && request.resource.data.source == 'storefront_newsletter'
                    && request.resource.data.status == 'active'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
